---
layout: layouts/base.njk
---
<section class="antet-pagina">
  <div class="interior despre__grila">
    <div class="despre__foto">
      <figure>
        <img class="foto" src="/assets/imagini/alexandra-pisaru-2.jpg" alt="Alexandra Pisaru, așezată într-un fotoliu verde" width="1086" height="1448" fetchpriority="high">
      </figure>
    </div>
    <div>
      <p class="eticheta">Despre mine</p>
      <h1>{{ salut }}</h1>
      <p class="intro">{{ site.titlu }}.</p>
      <div class="text-lung">
        {{ content | safe }}
      </div>

      <h2 class="titlu-formare">Formare</h2>
      <ul class="lista-formare">
        {%- for f in formare.lista %}
        <li><strong>{{ f.titlu }}</strong>{% if f.detalii %}{{ f.detalii }}{% endif %}</li>
        {%- endfor %}
      </ul>
      {%- if formare.inCurs %}
      <p class="formare-in-curs">{{ formare.inCurs }}</p>
      {%- endif %}
    </div>
  </div>
</section>

<section class="sectiune sectiune--banda" aria-labelledby="valori">
  <div class="interior">
    <div class="sectiune--centrat">
      <h2 id="valori">Ce poți aștepta de la mine</h2>
    </div>
    <div class="grila-teme">
      {%- for v in formare.valori %}
      <div class="card">
        <h3>{{ v.titlu }}</h3>
        <p>{{ v.text }}</p>
      </div>
      {%- endfor %}
    </div>
    {%- if formare.motto %}
    <blockquote class="citat citat--sub-carduri">
      <p>{{ formare.motto }}</p>
    </blockquote>
    {%- endif %}
  </div>
</section>

{% include "partials/final-contact.njk" %}
