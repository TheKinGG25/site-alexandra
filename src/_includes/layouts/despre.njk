---
layout: layouts/base.njk
---
<section class="antet-pagina">
  <div class="interior despre__grila">
    <figure class="despre__foto">
      <img class="foto" src="/assets/imagini/alexandra-pisaru-2.jpg" alt="Alexandra Pisaru, așezată într-un fotoliu verde" width="1086" height="1448" fetchpriority="high">
    </figure>
    <div class="despre__intro">
      <p class="eticheta">Despre mine</p>
      <h1>{{ salut }}</h1>
      <p class="intro">{{ site.titlu }}.</p>
      <div class="text-lung">
        {{ content | safe }}
      </div>
    </div>
  </div>
</section>

<section class="sectiune sectiune--fara-sus" aria-label="Parcurs și abordare">
  <div class="interior">
    <div class="rand-despre">
      <h2>{{ drum.titlu }}</h2>
      <div>
        {%- for p in drum.paragrafe %}
        <p class="intro">{{ p }}</p>
        {%- endfor %}
      </div>
    </div>

    <div class="rand-despre">
      <div>
        <h2>{{ lucru.titlu }}</h2>
        {%- if lucru.introducere %}<p class="intro">{{ lucru.introducere }}</p>{% endif %}
      </div>
      <div>
        {%- for p in lucru.paragrafe %}
        <p>{{ p }}</p>
        {%- endfor %}
      </div>
    </div>

    <div class="rand-despre">
      <h2>Formare</h2>
      <div>
        <ul class="lista-formare">
          {%- for f in formare.lista %}
          <li><strong>{{ f.titlu }}</strong>{% if f.detalii %}{{ f.detalii }}{% endif %}</li>
          {%- endfor %}
        </ul>
        {%- if formare.inCurs %}
        <p class="formare-in-curs">{{ formare.inCurs }}</p>
        {%- endif %}
      </div>
    </div>
  </div>
</section>

{%- if citat.text %}
<section class="sectiune sectiune--banda" aria-label="Citat">
  <div class="interior">
    <blockquote class="citat">
      <svg class="citat__semn" viewBox="0 0 40 30" fill="currentColor" aria-hidden="true"><path d="M0 30V17C0 7 5 1.5 14 0l1.5 4C10 5.5 7.5 9 7.5 13H15v17H0zm22 0V17c0-10 5-15.5 14-17l1.5 4C32 5.5 29.5 9 29.5 13H37v17H22z"/></svg>
      <p class="citat__text--lung">„{{ citat.text }}”</p>
      <footer>{{ citat.autor }}</footer>
    </blockquote>
  </div>
</section>
{%- endif %}

<section class="sectiune" aria-labelledby="valori">
  <div class="interior">
    <div class="sectiune--centrat">
      <h2 id="valori">Ce poți aștepta de la mine</h2>
    </div>
    <div class="grila-teme">
      {%- for v in formare.valori %}
      <div class="card card--pal">
        <h3>{{ v.titlu }}</h3>
        <p>{{ v.text }}</p>
      </div>
      {%- endfor %}
    </div>
    {%- if formare.motto %}
    <blockquote class="citat citat--sub-carduri">
      <p>{{ formare.motto }}</p>
    </blockquote>
    {%- endif %}
  </div>
</section>

{%- set finalBanda = true %}
{% include "partials/final-contact.njk" %}
