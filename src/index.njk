---
layout: layouts/base.njk
titluSeo: "Alexandra Pisaru | Psiholog clinician și psihoterapeut"
description: "Psihoterapie și consiliere în cabinet și online, pentru adulți, cupluri, familii și adolescenți de la 12 ani. Discuția inițială, de aproximativ 15 minute, este gratuită."
---
{%- from "partials/icoane.njk" import icoana -%}

<section class="hero">
  <div class="interior hero__grila">
    <div>
      <p class="eticheta">{{ acasa.eticheta }}</p>
      <h1>{{ acasa.titlu }}</h1>
      <p class="intro">{{ acasa.subtitlu }}</p>
      {%- if acasa.prezentare %}
      <p>{{ acasa.prezentare }}</p>
      {%- endif %}
      <div class="grup-butoane">
        <a class="buton" href="/contact/">{{ site.butonProgramare }}</a>
        <a class="buton buton--secundar" href="/despre-mine/">{{ acasa.butonSecundar }}</a>
      </div>
    </div>
    <figure class="hero__foto">
      <img src="/assets/imagini/alexandra-pisaru.jpg" alt="Alexandra Pisaru, psiholog clinician și psihoterapeut" width="1024" height="1536" fetchpriority="high">
    </figure>
  </div>
</section>

<section class="sectiune sectiune--banda" aria-label="Pe scurt">
  <div class="interior">
    <ul class="repere">
      {%- for r in acasa.repere %}
      <li><strong>{{ r.titlu }}</strong><span>{{ r.text }}</span></li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="sectiune" aria-labelledby="regasesti">
  <div class="interior">
    <div class="sectiune--centrat">
      <h2 id="regasesti">{{ acasa.regasesti.titlu }}</h2>
      <p class="intro">{{ acasa.regasesti.intro }}</p>
    </div>
    <div class="doua-coloane">
      <div class="card">
        <h3>{{ acasa.regasesti.acum.titlu }}</h3>
        <ul class="lista-puncte">
          {%- for p in acasa.regasesti.acum.puncte %}<li>{{ p }}</li>{% endfor %}
        </ul>
      </div>
      <div class="card card--pal">
        <h3>{{ acasa.regasesti.terapia.titlu }}</h3>
        <ul class="lista-puncte lista-puncte--plin">
          {%- for p in acasa.regasesti.terapia.puncte %}<li>{{ p }}</li>{% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="sectiune sectiune--banda" aria-labelledby="servicii">
  <div class="interior">
    <div class="sectiune--centrat">
      <h2 id="servicii">{{ acasa.servicii.titlu }}</h2>
      <p class="intro">{{ acasa.servicii.intro }}</p>
    </div>
    <div class="grila-carduri grila-carduri--patru">
      {%- for s in acasa.servicii.carduri %}
      <article class="card card-serviciu">
        {{ icoana(s.icoana or "frunza") | safe }}
        <h3>{{ s.titlu }}</h3>
        <p>{{ s.text }}</p>
      </article>
      {%- endfor %}
    </div>
    <p class="centrat-jos"><a class="link-sageata" href="/servicii/">{{ acasa.servicii.link }}</a></p>
  </div>
</section>

<section class="sectiune sectiune--centrat" aria-labelledby="cabinet-online">
  <div class="interior--text">
    <h2 id="cabinet-online">{{ acasa.cabinetOnline.titlu }}</h2>
    {%- for p in acasa.cabinetOnline.paragrafe %}
    <p class="intro">{{ p }}</p>
    {%- endfor %}
  </div>
</section>

{%- if collections.articole.length %}
<section class="sectiune sectiune--banda" aria-labelledby="articole">
  <div class="interior">
    <div class="sectiune--centrat">
      <p class="eticheta">Articole</p>
      <h2 id="articole">{{ acasa.articole.titlu }}</h2>
      <p class="intro">{{ acasa.articole.intro }}</p>
    </div>
    <div class="grila-carduri grila-carduri--articole">
      {%- for a in collections.articole | limita(3) %}
      {% include "partials/card-articol.njk" %}
      {%- endfor %}
    </div>
    <p class="centrat-jos"><a class="link-sageata" href="/articole/">Toate articolele</a></p>
  </div>
</section>
{%- endif %}

{% include "partials/final-contact.njk" %}
